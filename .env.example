# Application
PORT=8080
DATA_DIR=data

# PostgreSQL exposed by compose.yaml on the host at port 5433.
POSTGRES_DB=darling
POSTGRES_USER=darling
POSTGRES_PASSWORD=darling_local
DATABASE_URL=postgresql://darling:darling_local@127.0.0.1:5433/darling?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5
USER_DB_MAX_USERS=1000

# Optional WeChat Open Platform website QR-code login.
# Requires an approved Website Application; leave all values empty to keep anonymous mode.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URL=

# DeepSeek-backed chat agent
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=1.0
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_TIMEOUT=90

# Optional image model; keep empty if image generation is disabled.
AI_HIGH_API_KEY=
AI_HIGH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_HIGH_MODEL=gemini-2.5-flash-image
AI_HIGH_TEMPERATURE=0.8
AI_HIGH_MAX_TOKENS=4096
AI_HIGH_TIMEOUT=300

STICKER_CRAWL_ENABLED=true
STICKER_GENERATION_ENABLED=false
